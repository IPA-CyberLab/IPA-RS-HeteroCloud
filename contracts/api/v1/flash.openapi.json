{
  "openapi": "3.1.0",
  "info": {
    "title": "HeteroCloud Flash API",
    "version": "v1",
    "description": "Scoped Flash read/create/update contract, not the complete HeteroCloud API. Runtime validation also applies existing image, DNS label, CIDR, environment and process argument constraints."
  },
  "paths": {
    "/api/v1/flash/gpu-types": {
      "get": {
        "summary": "List GPU types visible to the authenticated actor",
        "description": "Synchronizes FlashGpuDevice inventory from the provider, aggregates accessible devices by type, and never exposes a physical device identity. available is the provider-reported healthy and unleased count. Busy services are accepted and queued by the Flash scheduler.",
        "responses": {
          "200": {
            "description": "Accessible GPU types",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GpuTypeAvailability"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "503": {
            "description": "Flash provider catalog unavailable"
          }
        }
      }
    },
    "/api/v1/organizations/{organization_id}/flash/services": {
      "parameters": [
        {
          "name": "organization_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "List Flash services with best-effort live autoscaling status",
        "description": "Requires flash:ListInstances. Optional project filter; currently no pagination limit. Autoscaled services refresh with concurrency four and one absolute two-second provider refresh budget including queue time. Fixed services are unchanged. Provider failure never fails the list: inner status is marked live_status_unavailable and desired/ready counts are absent. Database state and generation are never changed.",
        "parameters": [
          {
            "name": "project_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Services in stored list order; live status may be unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/FlashServiceRead"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission denied"
          }
        }
      },
      "post": {
        "summary": "Create a Flash service",
        "description": "Validation and quota reservation occur before acceptance. CPU, memory, disk and replica quotas use autoscaling.max_replicas, or replicas for fixed services. Updates replace the previous reservation transactionally.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFlashService"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted service instance",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "spec"
                  ],
                  "properties": {
                    "spec": {
                      "$ref": "#/components/schemas/FlashSpec"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid specification or quota exceeded"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission denied"
          },
          "404": {
            "description": "Project or service not found"
          },
          "422": {
            "description": "Malformed request body"
          },
          "503": {
            "description": "Flash provider GPU catalog unavailable when gpu_type is requested"
          }
        }
      }
    },
    "/api/v1/organizations/{organization_id}/flash/services/{service_instance_id}": {
      "parameters": [
        {
          "name": "organization_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "service_instance_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Read a Flash service with best-effort live autoscaling status",
        "description": "Requires flash:GetInstance. Autoscaled services use a signed, read-only provider GET with a two-second deadline and exact observed_generation matching. Success replaces status.status. Failure retains cached status with live_status_unavailable: true and removes desired_replicas/ready_replicas; cached endpoints may remain. Fixed services are unchanged. No database lifecycle, generation, or spec mutation occurs.",
        "responses": {
          "200": {
            "description": "Service with live or explicitly unavailable autoscaling status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlashServiceRead"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission denied"
          },
          "404": {
            "description": "Service not found"
          }
        }
      },
      "put": {
        "summary": "Replace a Flash service specification",
        "description": "Validation and quota reservation occur before acceptance. CPU, memory, disk and replica quotas use autoscaling.max_replicas, or replicas for fixed services. Updates replace the previous reservation transactionally.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFlashService"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted service instance",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "spec"
                  ],
                  "properties": {
                    "spec": {
                      "$ref": "#/components/schemas/FlashSpec"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid specification or quota exceeded"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission denied"
          },
          "404": {
            "description": "Project or service not found"
          },
          "422": {
            "description": "Malformed request body"
          },
          "503": {
            "description": "Flash provider GPU catalog unavailable when gpu_type is requested"
          }
        }
      }
    },
    "/api/v1/owner/gpus": {
      "get": {
        "summary": "Synchronize and list physical GPU inventory for the owner console",
        "description": "Requires the owner host, network, account, and session boundary. Pulls the FlashGpuDevice provider catalog before returning.",
        "responses": {
          "200": {
            "description": "Physical GPU inventory",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/OwnerGpuDevice"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Owner boundary rejected"
          },
          "503": {
            "description": "Flash provider unavailable"
          }
        }
      }
    },
    "/api/v1/owner/gpus/{gpu_device_id}": {
      "parameters": [
        {
          "name": "gpu_device_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "put": {
        "summary": "Replace a physical GPU access policy",
        "description": "Requires owner same-origin and CSRF validation. Pushes the access policy to the provider CRD and refreshes the local catalog. Physical identity and type cannot be changed here.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateGpuAccess"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated physical GPU",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OwnerGpuDevice"
                }
              }
            }
          },
          "400": {
            "description": "Invalid visibility or user assignment"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Owner boundary rejected"
          },
          "404": {
            "description": "GPU not found"
          },
          "503": {
            "description": "Flash provider unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FlashServiceRead": {
        "type": "object",
        "required": [
          "id",
          "state",
          "generation",
          "spec",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "description": "Persisted lifecycle state, unchanged by live status reads."
          },
          "generation": {
            "type": "integer"
          },
          "spec": {
            "$ref": "#/components/schemas/FlashSpec"
          },
          "status": {
            "type": "object",
            "properties": {
              "operation_id": {
                "type": "string"
              },
              "status": {
                "$ref": "#/components/schemas/FlashObservedStatus"
              }
            }
          }
        }
      },
      "FlashObservedStatus": {
        "type": "object",
        "description": "Live provider fields when available, otherwise cached fields with an explicit unavailable marker. Counts are never current when live_status_unavailable is true; cached endpoints may be stale.",
        "properties": {
          "observed_generation": {
            "type": "integer"
          },
          "desired_replicas": {
            "type": "integer",
            "minimum": 0
          },
          "ready_replicas": {
            "type": "integer",
            "minimum": 0
          },
          "phase": {
            "type": "string"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "live_status_unavailable": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "live_status_unavailable"
              ],
              "properties": {
                "live_status_unavailable": {
                  "const": true
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "desired_replicas"
                    ]
                  },
                  {
                    "required": [
                      "ready_replicas"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "FlashAutoscaling": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "min_replicas",
          "max_replicas"
        ],
        "description": "At least one non-null utilization target is required. The API enforces max_replicas >= min_replicas and min_replicas <= spec.replicas <= max_replicas. Quotas reserve max_replicas.",
        "properties": {
          "min_replicas": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "max_replicas": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "target_cpu_utilization_percent": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100
          },
          "target_memory_utilization_percent": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 100
          }
        },
        "anyOf": [
          {
            "required": [
              "target_cpu_utilization_percent"
            ],
            "properties": {
              "target_cpu_utilization_percent": {
                "type": "integer"
              }
            }
          },
          {
            "required": [
              "target_memory_utilization_percent"
            ],
            "properties": {
              "target_memory_utilization_percent": {
                "type": "integer"
              }
            }
          }
        ]
      },
      "FlashExposure": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "traffic_mode"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "internal",
              "public"
            ]
          },
          "traffic_mode": {
            "type": "string",
            "enum": [
              "forwarded",
              "direct"
            ]
          },
          "endpoint_mode": {
            "type": "string",
            "enum": [
              "ip",
              "load_balancer",
              "web"
            ],
            "default": "ip",
            "description": "ip is omitted when serialized. load_balancer and web require public exposure and forwarded traffic. web publishes HTTP via an HTTPS hostname on TCP 443 and requires exactly one TCP port and empty source allow/deny lists."
          },
          "allowed_source_cidrs": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string"
            },
            "default": []
          },
          "denied_source_cidrs": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string"
            },
            "default": []
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "internal"
                }
              }
            },
            "then": {
              "properties": {
                "traffic_mode": {
                  "const": "forwarded"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "endpoint_mode"
              ],
              "properties": {
                "endpoint_mode": {
                  "enum": [
                    "load_balancer",
                    "web"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "type": {
                  "const": "public"
                },
                "traffic_mode": {
                  "const": "forwarded"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "endpoint_mode"
              ],
              "properties": {
                "endpoint_mode": {
                  "const": "web"
                }
              }
            },
            "then": {
              "properties": {
                "allowed_source_cidrs": {
                  "maxItems": 0
                },
                "denied_source_cidrs": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      },
      "FlashPort": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "protocol",
          "container_port"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 63
          },
          "protocol": {
            "type": "string",
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "container_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "service_port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "default": 0,
            "description": "Request value is replaced by the server with an assigned port in 30000..32767."
          }
        }
      },
      "FlashEgress": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "disabled",
              "restricted",
              "internet"
            ],
            "default": "internet"
          },
          "allow_same_organization": {
            "type": "boolean",
            "default": false
          },
          "allowed_destination_cidrs": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string"
            },
            "default": []
          },
          "denied_destination_cidrs": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      },
      "FlashSpec": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "exposure"
              ],
              "properties": {
                "exposure": {
                  "required": [
                    "endpoint_mode"
                  ],
                  "properties": {
                    "endpoint_mode": {
                      "const": "web"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "ports": {
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "properties": {
                      "protocol": {
                        "const": "tcp"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "gpu_type"
              ]
            },
            "then": {
              "properties": {
                "replicas": {
                  "const": 1
                },
                "autoscaling": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "max_replicas": {
                          "const": 1
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ],
        "required": [
          "region",
          "image",
          "replicas",
          "cpu_millis",
          "memory_mib",
          "ports",
          "exposure",
          "env",
          "command",
          "args",
          "metadata"
        ],
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "image": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "replicas": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "description": "Initial desired replicas; must be within autoscaling bounds when enabled."
          },
          "autoscaling": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FlashAutoscaling"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional. Omitted for fixed services; null also disables autoscaling."
          },
          "cpu_millis": {
            "type": "integer",
            "minimum": 10,
            "maximum": 100000000
          },
          "memory_mib": {
            "type": "integer",
            "minimum": 16,
            "maximum": 1048576
          },
          "gpu_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
            "description": "Optional canonical GPU type. One exclusive physical GPU is requested. GPU services require replicas=1 and autoscaling.max_replicas=1; users cannot select a physical device."
          },
          "ephemeral_storage_gib": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "default": 10
          },
          "ports": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "$ref": "#/components/schemas/FlashPort"
            }
          },
          "exposure": {
            "$ref": "#/components/schemas/FlashExposure"
          },
          "egress": {
            "$ref": "#/components/schemas/FlashEgress"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "CreateFlashService": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "name",
          "spec"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "spec": {
            "$ref": "#/components/schemas/FlashSpec"
          }
        }
      },
      "UpdateFlashService": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "spec"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "spec": {
            "$ref": "#/components/schemas/FlashSpec"
          }
        }
      },
      "GpuTypeAvailability": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gpu_type",
          "display_name",
          "access",
          "total",
          "available"
        ],
        "properties": {
          "gpu_type": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "access": {
            "type": "string",
            "enum": [
              "open",
              "private"
            ],
            "description": "open when at least one accessible device of this type is open; otherwise private."
          },
          "total": {
            "type": "integer",
            "minimum": 1
          },
          "available": {
            "type": "integer",
            "minimum": 0,
            "description": "Provider-reported healthy and currently unleased accessible devices. Advisory; busy requests are accepted and queued."
          }
        }
      },
      "UpdateGpuAccess": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "visibility"
        ],
        "properties": {
          "visibility": {
            "type": "string",
            "enum": [
              "open",
              "private"
            ]
          },
          "assigned_user_ids": {
            "type": "array",
            "default": [],
            "maxItems": 10000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "description": "assigned_user_ids must be empty for open GPUs and must reference active users for private GPUs. An empty private list intentionally isolates the GPU from every user."
      },
      "OwnerGpuDevice": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "management_id",
          "gpu_type",
          "display_name",
          "available",
          "visibility",
          "assigned_user_ids",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "management_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "gpu_type": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "visibility": {
            "type": "string",
            "enum": [
              "open",
              "private"
            ]
          },
          "assigned_user_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "available": {
            "type": "boolean",
            "description": "Provider-reported healthy and currently unleased state."
          }
        }
      }
    }
  }
}
