(heterocloud_keycloak) {
	reverse_proxy 10.250.0.4:18079 10.250.0.5:18079 10.250.0.6:18079 10.250.0.8:18079 10.250.0.10:18079 {
		lb_policy first
		lb_try_duration 5s
		lb_try_interval 100ms
		fail_duration 10s
		max_fails 1
		unhealthy_status 5xx
		health_uri /health/ready
		health_interval 2s
		health_timeout 2s
		health_status 2xx
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Port 443
	}
}

(heterocloud_envoy) {
	reverse_proxy 10.250.0.4:18082 10.250.0.5:18082 10.250.0.6:18082 10.250.0.10:18082 {
		lb_policy first
		lb_try_duration 5s
		lb_try_interval 100ms
		fail_duration 10s
		max_fails 1
		unhealthy_status 5xx
		health_uri {args[0]}
		health_headers {
			Host {args[1]}
		}
		health_interval 2s
		health_timeout 2s
		health_status 2xx
	}
}

(heterocloud_frontend) {
	@realm path /id/realms/heterocloud /id/realms/heterocloud/*
	@resources path /id/resources/* /id/robots.txt /resources/* /robots.txt

	handle @realm {
		uri strip_prefix /id
		import heterocloud_keycloak
	}

	handle @resources {
		uri strip_prefix /id
		import heterocloud_keycloak
	}

	handle {
		import heterocloud_envoy /api/v1/health/live heterocloud.mizuame.app
	}
}

http://heterocloud.mizuame.app {
	import heterocloud_frontend
}

heterocloud.mizuame.app {
	import heterocloud_public_tls
	import heterocloud_frontend
}

cloud-a.heterocloud.mizuame.app {
	import heterocloud_envoy /api/v1/health/live heterocloud.mizuame.app
}

http://flow.heterocloud.mizuame.app {
	@acme_loop {
		path /.well-known/acme-challenge/*
		header X-HeteroCloud-ACME-Visited-A 1
	}

	handle @acme_loop {
		respond 404
	}

	handle /.well-known/acme-challenge/* {
		reverse_proxy 163.220.236.52:80 {
			header_up Host {host}
			header_up X-HeteroCloud-ACME-Visited-A 1
		}
	}

	handle {
		redir https://flow.heterocloud.mizuame.app{uri} permanent
	}
}

flow.heterocloud.mizuame.app {
	import heterocloud_public_tls

	@internal path /internal /internal/*
	handle @internal {
		respond 404
	}

	handle {
		import heterocloud_envoy /health/live flow.heterocloud.mizuame.app
	}
}

http://registry.heterocloud.mizuame.app {
	@registry_acme_loop {
		path /.well-known/acme-challenge/*
		header X-HeteroCloud-Registry-ACME-Visited-A 1
	}

	handle @registry_acme_loop {
		respond 404
	}

	handle /.well-known/acme-challenge/* {
		reverse_proxy 163.220.236.52:80 {
			header_up Host {host}
			header_up X-HeteroCloud-Registry-ACME-Visited-A 1
		}
	}

	handle {
		redir https://registry.heterocloud.mizuame.app{uri} permanent
	}
}

registry.heterocloud.mizuame.app {
	import heterocloud_public_tls

	import heterocloud_envoy /api/v2.0/health registry.heterocloud.mizuame.app
}

http://s3.heterocloud.mizuame.app {
	@syouyu_acme_loop {
		path /.well-known/acme-challenge/*
		header X-HeteroCloud-Syouyu-ACME-Visited-A 1
	}

	handle @syouyu_acme_loop {
		respond 404
	}

	handle /.well-known/acme-challenge/* {
		reverse_proxy 163.220.236.52:80 {
			header_up Host {host}
			header_up X-HeteroCloud-Syouyu-ACME-Visited-A 1
		}
	}

	handle {
		redir https://s3.heterocloud.mizuame.app{uri} permanent
	}
}

s3.heterocloud.mizuame.app {
	import heterocloud_public_tls

	import heterocloud_envoy /api/v1/health/live heterocloud.mizuame.app
}

http://secrets.heterocloud.mizuame.app {
	redir https://secrets.heterocloud.mizuame.app{uri} 308
}

secrets.heterocloud.mizuame.app {
	import heterocloud_public_tls
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	import heterocloud_envoy /v1/sys/health?standbyok=true secrets.heterocloud.mizuame.app
}

# OpenBao is served only on the HeteroNetwork WireGuard address. The public
# hostname is retained for its existing OIDC callback and trusted TLS cert.
https://:443 {
	bind 10.250.0.4
	import heterocloud_public_tls
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy https://openbao-active.openbao.svc.cluster.local:8200 {
		header_up Host openbao-active.openbao.svc.cluster.local
		transport http {
			resolvers 10.96.0.10
			tls_trust_pool file /etc/heteronetwork/openbao-ca.crt
			tls_server_name openbao-active.openbao.svc.cluster.local
		}
	}
}

http://:18082 {
	bind 10.250.0.4
	@vpn remote_ip 10.250.0.0/16 127.0.0.0/8
	handle @vpn {
		reverse_proxy http://heterocloud-edge-proxy.envoy-gateway-system.svc.cluster.local:18081 {
			transport http {
				resolvers 10.96.0.10
			}
		}
	}
	handle {
		respond 403
	}
}
