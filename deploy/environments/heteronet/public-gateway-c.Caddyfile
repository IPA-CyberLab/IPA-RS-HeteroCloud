(heterocloud_frontend) {
	@realm path /id/realms/heterocloud /id/realms/heterocloud/*
	@resources path /id/resources/* /id/robots.txt /resources/* /robots.txt

	handle @realm {
		uri strip_prefix /id
		reverse_proxy http://127.0.0.1:18079 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Port 443
		}
	}

	handle @resources {
		uri strip_prefix /id
		reverse_proxy http://127.0.0.1:18079 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Port 443
		}
	}

	handle {
		reverse_proxy https://10.250.0.6:8443 https://10.250.0.4:8443 https://10.250.0.5:8443 {
			lb_policy first
			health_uri /api/v1/health/live
			health_interval 5s
			health_timeout 2s
			fail_duration 10s
			max_fails 2
			transport http {
				tls_insecure_skip_verify
			}
		}
	}
}

http://heterocloud.mizuame.app {
	import heterocloud_frontend
}

heterocloud.mizuame.app {
	tls internal
	import heterocloud_frontend
}

cloud-c.heterocloud.mizuame.app {
	reverse_proxy https://10.250.0.6:8443 https://10.250.0.4:8443 https://10.250.0.5:8443 {
		lb_policy first
		health_uri /api/v1/health/live
		health_interval 5s
		health_timeout 2s
		fail_duration 10s
		max_fails 2
		transport http {
			tls_insecure_skip_verify
		}
	}
}

http://flow.heterocloud.mizuame.app {
	@acme_loop {
		path /.well-known/acme-challenge/*
		header X-HeteroCloud-ACME-Visited-C 1
	}

	handle @acme_loop {
		respond 404
	}

	handle /.well-known/acme-challenge/* {
		reverse_proxy 10.250.0.4:80 {
			header_up Host {host}
			header_up X-HeteroCloud-ACME-Visited-C 1
		}
	}

	handle {
		redir https://flow.heterocloud.mizuame.app{uri} permanent
	}
}

flow.heterocloud.mizuame.app {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}

	@internal path /internal /internal/*
	handle @internal {
		respond 404
	}

	@rtc path /rtc /rtc/*
	handle @rtc {
		reverse_proxy 10.250.0.6:7880
	}

	handle /v1/signal/* {
		reverse_proxy 10.250.0.6:8082
	}

	handle {
		reverse_proxy 10.250.0.6:8080
	}
}
