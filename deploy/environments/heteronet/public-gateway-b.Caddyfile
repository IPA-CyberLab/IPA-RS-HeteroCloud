(heterocloud_frontend) {
	@realm path /id/realms/heterocloud /id/realms/heterocloud/*
	@resources path /resources/* /robots.txt

	handle @realm {
		uri strip_prefix /id
		reverse_proxy http://127.0.0.1:18079 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Port 443
		}
	}

	handle @resources {
		reverse_proxy http://127.0.0.1:18079 {
			header_up Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Port 443
		}
	}

	handle {
		reverse_proxy https://10.250.0.5:8443 https://10.250.0.6:8443 https://10.250.0.4:8443 {
			lb_policy first
			health_uri /api/v1/health/live
			health_interval 5s
			health_timeout 2s
			fail_duration 10s
			max_fails 2
			transport http {
				tls_insecure_skip_verify
			}
		}
	}
}

http://heterocloud.mizuame.app {
	import heterocloud_frontend
}

heterocloud.mizuame.app {
	tls internal
	import heterocloud_frontend
}

cloud-b.heterocloud.mizuame.app {
	reverse_proxy https://10.250.0.5:8443 https://10.250.0.6:8443 https://10.250.0.4:8443 {
		lb_policy first
		health_uri /api/v1/health/live
		health_interval 5s
		health_timeout 2s
		fail_duration 10s
		max_fails 2
		transport http {
			tls_insecure_skip_verify
		}
	}
}

flow-b.heterocloud.mizuame.app {
	handle /internal/* {
		respond 404
	}

	handle /v1/signal/* {
		reverse_proxy 10.250.0.5:8082 10.250.0.6:8082 10.250.0.4:8082 {
			lb_policy first
			health_uri /health/live
			health_interval 5s
			health_timeout 2s
			fail_duration 10s
			max_fails 2
		}
	}

	handle {
		reverse_proxy 10.250.0.5:8080 10.250.0.6:8080 10.250.0.4:8080 {
			lb_policy first
			health_uri /health/live
			health_interval 5s
			health_timeout 2s
			fail_duration 10s
			max_fails 2
		}
	}
}

rtc-b.heterocloud.mizuame.app {
	reverse_proxy 10.250.0.5:7880 10.250.0.6:7880 10.250.0.4:7880 {
		lb_policy first
		health_uri /
		health_interval 5s
		health_timeout 2s
		fail_duration 10s
		max_fails 2
	}
}
