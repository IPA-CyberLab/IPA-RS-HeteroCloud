{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "oidc": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "rootCaSecretName": {"type": "string"},
        "rootCaSecretKey": {"type": "string", "minLength": 1}
      },
      "if": {"required": ["rootCaSecretName"], "properties": {"rootCaSecretName": {"type": "string", "minLength": 1}}},
      "then": {"required": ["enabled"], "properties": {"enabled": {"const": true}}}
    },
    "databaseTls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caSecretName", "caSecretKey"],
      "properties": {
        "caSecretName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "caSecretKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "ownerConsole": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "origin": { "type": "string" },
        "secureCookie": { "type": "boolean" }
      }
    },
    "hostAliases": {
      "description": "Pod-local hostname mappings for the API and owner console.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ip", "hostnames"],
        "properties": {
          "ip": {
            "type": "string",
            "anyOf": [{ "format": "ipv4" }, { "format": "ipv6" }]
          },
          "hostnames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
            }
          }
        }
      }
    }
  }
}
